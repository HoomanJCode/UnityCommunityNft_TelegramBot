# URL of the TON Connect manifest (deployed app URL in production)
# VITE_TON_MANIFEST_URL=https://your-domain.com/tonconnect-manifest.json

# DEV ONLY — a pre-signed initData string to test the gallery/linking in a
# plain browser (where window.Telegram.WebApp does not exist). In production
# the app always uses the real initData provided by Telegram.
# VITE_DEV_INIT_DATA=
