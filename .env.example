# ============================================================
# Telegram Bot
# ============================================================
BOT_TOKEN=your_bot_token_from_botfather_here

# ============================================================
# TON Blockchain
# ============================================================
TON_NETWORK=testnet                                  # testnet or mainnet
TON_API_KEY=your_tonapi_key_here                     # https://tonapi.io
DEPLOYER_MNEMONIC="word1 word2 word3 ... word24"     # hot wallet for deploying contracts + minting

# ============================================================
# Backend
# ============================================================
DATABASE_URL=sqlite:///./data.db                     # SQLite for dev, Postgres URL for prod
MINI_APP_URL=http://localhost:5173                    # Vite dev server or production URL
ADMIN_WEB_URL=http://localhost:5174                   # Admin dashboard URL

# ============================================================
# Mini App (Telegram)
# ============================================================
# Used for initData HMAC verification — must match the bot token above
MINI_APP_BOT_TOKEN=${BOT_TOKEN}

# ============================================================
# Admin / Debug
# ============================================================
ADMIN_PASSWORD=change_me                             # temporary shared password for admin dashboard
DEBUG=true
