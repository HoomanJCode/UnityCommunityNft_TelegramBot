# ============================================================
# Python (Telegram bot)
# ============================================================

# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Test / lint / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# Jupyter notebooks (if used for prototyping)
.ipynb_checkpoints/

# ============================================================
# Secrets & credentials (bot + web3)
# ============================================================

# Never commit environment files with API keys / wallet keys
.env
.env.*
!.env.example

# Private keys & keystores
*.pem
*.key
*.p12
*.p8
keystore/
!keystore/README.md

# Telegram bot tokens, webhook certs
*.pem

# Local databases (dev SQLite lives next to the repo)
*.db
*.sqlite
*.sqlite3
*.db-journal
!tests/fixtures/*.db

# ============================================================
# Smart contracts — Hardhat
# ============================================================

node_modules/
artifacts/
cache/
typechain/
typechain-types/

# Keep committed deployment info except local ephemeral networks
deployments/localhost/
deployments/hardhat/

# OpenZeppelin upgradeable contract tracking (commit this if using upgrades)
# .openzeppelin/

# ============================================================
# Smart contracts — Foundry
# ============================================================

out/
broadcast/
lib/

